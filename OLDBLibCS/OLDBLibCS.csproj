<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <PackageId>OLDBLibCS</PackageId>
    <Title>OLDBLibCS</Title>
    <PackageVersion>1.3.0</PackageVersion>
    <Authors>kaolick</Authors>
    <Copyright>kaolick 2024</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageOutputPath>bin\Release</PackageOutputPath>
    <RepositoryUrl>https://github.com/kaolick/OLDBLibCS</RepositoryUrl>
    <PackageReleaseNotes>Updated to latest openligadb.de API</PackageReleaseNotes>
    <Description>An easy-to-use C# API for openligadb.de</Description>
    <Summary>An easy-to-use C# API for openligadb.de</Summary>
    <PackageTags>OpenligaDB.de API Bundesliga Soccer</PackageTags>
    <LangVersion>8</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="API\" />
    <Folder Include="Model\" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="refit" Version="7.2.22" />
  </ItemGroup>
</Project>
